{
  "name": "edge-upi-behaviour-risk-system",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "tsx watch --ignore \"vite.config.ts.timestamp-*\" --ignore \"./data/**\" --ignore \"./models/**\" --ignore \"./dist/**\" --ignore \"./archive/**\" --ignore \"**/__pycache__/**\" --ignore \"*.db\" --ignore \"*.db-journal\" server.ts",
    "dev:api": "python backend/main.py",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && vite build",
    "start": "vite preview",
    "cap:sync": "cap sync",
    "cap:build": "npm run build && cap sync",
    "cap:open:android": "cap open android"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/core": "^8.5.0",
    "express": "^4.19.2",
    "form-data": "^4.0.6",
    "jsqr": "^1.4.0",
    "lucide-react": "^0.395.0",
    "motion": "^11.2.10",
    "multer": "^1.4.5-lts.1",
    "pdf2json": "^4.0.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.12.7"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.0",
    "@tailwindcss/vite": "^4.0.0",
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.11",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.2.1",
    "esbuild": "^0.21.3",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.11.0",
    "typescript": "^5.4.5",
    "vite": "^5.2.11"
  }
}
