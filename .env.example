# Copy this file to .env and fill in real values. .env is gitignored.

# --- Servers -------------------------------------------------------------
PORT=3001
PYTHON_BACKEND_URL=http://127.0.0.1:8000

# --- Auth ----------------------------------------------------------------
# Generate with:  python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_TTL_HOURS=24

# --- Postgres (only needed by backend/api.py) ----------------------------
PGHOST=localhost
PGPORT=5432
PGDATABASE=edge_upi_risk
PGUSER=postgres
PGPASSWORD=
