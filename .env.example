# Copy this file to .env and fill in real values. .env is gitignored.

# --- Servers -------------------------------------------------------------
PORT=3001
PYTHON_BACKEND_URL=http://127.0.0.1:8000

# --- Auth ----------------------------------------------------------------
# Generate with:  python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_TTL_HOURS=24

# --- Postgres (only needed by backend/api.py) ----------------------------
PGHOST=localhost
PGPORT=5432
PGDATABASE=edge_upi_risk
PGUSER=postgres
PGPASSWORD=

# --- UPI ID verification (optional) --------------------------------------
# Accounts are identified by UPI ID. Format and PSP handle are always checked
# locally. Confirming the account actually EXISTS needs a payment provider -
# Razorpay, Cashfree and PayU all expose VPA validation. Without one, the app
# says an address is unverified rather than claiming it checked.
# The endpoint should take {"vpa": "..."} and answer {"valid": true, "name": "..."}.
UPI_VERIFY_URL=
UPI_VERIFY_KEY=
UPI_VERIFY_PROVIDER=
# Set true to refuse registration when verification cannot be completed.
UPI_VERIFY_REQUIRED=false

# --- Assistant (optional) ------------------------------------------------
# The in-app assistant that explains what a check found. It EXPLAINS; it
# never decides - every verdict comes from the deterministic engine, and the
# assistant has no tools and cannot act. With no key set the app still works;
# the assistant just says it is not connected.
#
# Free key, no credit card:  https://console.groq.com/keys
# Groq's free tier allows 30 requests/minute and 1,000/day across the whole
# key, so backend/app/services/chat.py also limits each user to 6/minute.
CHAT_API_KEY=
# Which model. A provider's docs list what it RUNS, not what your key may
# reach: llama-3.3-70b-versatile is on Groq's model page and answers
# 404 model_not_found on a free key. Ask your own key instead of guessing:
#     python scripts/check_assistant.py --models
# gpt-oss-120b is confirmed working on a free account; gpt-oss-20b and
# llama-3.1-8b-instant are faster if answers are slow.
CHAT_MODEL=openai/gpt-oss-120b
# Any OpenAI-compatible endpoint. Groq by default; point it at
# http://localhost:11434/v1 to run a local model through Ollama instead, with
# no code change.
CHAT_BASE_URL=https://api.groq.com/openai/v1
